# UID con el que corren los procesos de Airflow dentro del contenedor.
# En Linux la doc oficial pide `id -u`; en Windows no existe, se usa el default de la imagen.
AIRFLOW_UID=50000

# Clave con la que Airflow cifra las credenciales de las Connections en su base de metadata.
# Generar una propia (NO reusar esta) con:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
